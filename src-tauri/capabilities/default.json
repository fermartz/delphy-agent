{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    "allow-get-secret",
    "allow-set-secret",
    "allow-delete-secret",
    "allow-list-user-themes",
    "allow-spawn-mcp-server",
    "allow-send-mcp-stdin",
    "allow-stop-mcp-server",
    "allow-replace-session-messages",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://localhost:*/**" },
        { "url": "http://127.0.0.1:*/**" }
      ]
    }
  ]
}
