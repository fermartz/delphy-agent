{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "allow-get-secret",
    "allow-set-secret",
    "allow-delete-secret",
    "allow-list-user-themes",
    "allow-spawn-mcp-server",
    "allow-send-mcp-stdin",
    "allow-stop-mcp-server"
  ]
}
